{
  "name": "snap-pdf",
  "private": true,
  "version": "1.0.0",
  "description": "複数の画像をまとめて1つのPDFにするPWAアプリ",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "predev": "npm run prepare-assets",
    "dev": "vite",
    "prebuild": "npm run prepare-assets",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.3.31",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "optionalDependencies": {
    "@pdf-lib/fontkit": "^1.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "browserslist": [
    "iOS >= 15",
    "Safari >= 15",
    "Chrome >= 100",
    "Firefox >= 100",
    "Edge >= 100"
  ]
}
